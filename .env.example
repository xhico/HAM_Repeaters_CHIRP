# Copy this file to .env and fill it in.
#
#   cp .env.example .env
#
# .env is gitignored, so your QTH and SMTP password stay out of the
# repository. Running in Docker, pass these as environment variables
# instead — real environment variables always win over this file.
#
# Everything here is optional. With none of it set, the script still
# builds chirp.csv; it just skips distances and never emails.

# ─── Your station ─────────────────────────────────────────────────────────────
# Decimal degrees. South latitudes and west longitudes are negative, so
# HOME_CENTER_LON is negative anywhere in Portugal.
#
# With both set, every channel's Comment ends with its distance from you,
# the browser view gains a Distance column, and repeaters sharing a
# frequency are ordered nearest first.

HOME_CENTER_LAT=
HOME_CENTER_LON=

# ─── Schedule (service.py / Docker only) ──────────────────────────────────────
# Hours between rebuilds, floored at 1. Each run is ~140 requests to
# anacom.pt over ~100 seconds, and licenses change on a scale of months,
# so weekly is the default. A small random buffer is added to every sleep
# so a fleet of these never lands on ANACOM at the same instant.
CHIRP_INTERVAL_HOURS=168

# Rebuild once at startup instead of waiting out the first interval.
CHIRP_RUN_ON_START=true

# Where chirp.csv and chirp.html are written. In Docker this must be the
# mounted volume: the previous CSV is what the change report compares
# against, so on a throwaway path every restart looks like a first run.
CHIRP_OUTPUT_DIR=/data

# ─── Email (service.py / Docker only) ─────────────────────────────────────────
# Mail goes out only when the list actually changes — never on a first
# run, and never when nothing moved. Leave EMAIL_TO or SMTP_HOST empty and
# changes are logged instead of mailed.
#
# EMAIL_TO takes a comma-separated list. Recipients are sent as Bcc, so no
# one sees the others.

EMAIL_TO=you@example.com
EMAIL_FROM=HAM Repeaters <alerts@example.com>

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=change-me
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=30
