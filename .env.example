# Copy this file to .env and set your own station position.
#
#   cp .env.example .env
#
# .env is gitignored, so your QTH stays out of the repository.
#
# With both values set, every channel's Comment ends with its distance
# from you, and repeaters sharing a frequency are ordered nearest first.
# Leave them empty (or delete .env) and distances are skipped entirely.
#
# Decimal degrees. South latitudes and west longitudes are negative —
# Portugal is west of Greenwich, so HOME_CENTER_LON is negative here.
#
#   HOME_CENTER_LAT=38.7223
#   HOME_CENTER_LON=-9.1393
#
# Real environment variables win over this file, so you can override for
# a single run:
#
#   HOME_CENTER_LAT=41.1579 HOME_CENTER_LON=-8.6291 python3 HAM_Repeaters_CHIRP.py

HOME_CENTER_LAT=
HOME_CENTER_LON=
